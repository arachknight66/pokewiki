generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String    @unique @db.VarChar(255)
  username       String    @unique @db.VarChar(50)
  password_hash  String    @db.VarChar(255)
  
  profile_bio    String?   @db.Text
  avatar_url     String?   @db.Text
  
  preferences    Json      @default("{\"theme\": \"light\", \"notifications\": true}")
  
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  updated_at     DateTime? @default(now()) @db.Timestamp(6)
  last_login     DateTime? @db.Timestamp(6)
  
  email_verified Boolean?  @default(false)
  is_active      Boolean?  @default(true)

  forum_threads  ForumThread[]
  forum_replies  ForumReply[]
  teams          Team[]
  forum_votes    ForumVote[]
  tournaments    Tournament[]
  tournament_submissions TournamentSubmission[]
  forum_reports  ForumReport[]

  @@map("users")
}

model ForumThread {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String    @db.Uuid
  
  category      String    @db.VarChar(50)
  title         String    @db.VarChar(200)
  body          String    @db.Text
  
  views         Int?      @default(0)
  replies_count Int?      @default(0)
  
  pinned        Boolean?  @default(false)
  locked        Boolean?  @default(false)
  
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)

  user          User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  replies       ForumReply[]

  @@map("forum_threads")
  @@index([category, created_at(sort: Desc)])
  @@index([user_id])
  @@index([created_at(sort: Desc)])
  @@index([views(sort: Desc)])
}

model ForumReply {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  thread_id     String    @db.Uuid
  user_id       String    @db.Uuid
  
  body          String    @db.Text
  
  upvotes       Int?      @default(0)
  downvotes     Int?      @default(0)
  net_votes     Int?      @default(0)
  
  is_edited     Boolean?  @default(false)
  edited_at     DateTime? @db.Timestamp(6)
  
  created_at    DateTime? @default(now()) @db.Timestamp(6)

  thread        ForumThread @relation(fields: [thread_id], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  votes         ForumVote[]

  @@map("forum_replies")
  @@index([thread_id, created_at(sort: Asc)])
  @@index([user_id])
  @@index([net_votes(sort: Desc)])
  @@index([created_at(sort: Desc)])
}

model Team {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String    @db.Uuid
  
  name          String    @db.VarChar(150)
  description   String?   @db.Text
  format        String?   @default("OU") @db.VarChar(50)
  
  pokemon_ids   Int[]
  
  rating_score  Decimal?  @default(0) @db.Decimal(5, 2)
  is_public     Boolean?  @default(false)
  views         Int?      @default(0)
  
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)

  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  tournament_submissions TournamentSubmission[]

  @@map("teams")
  @@index([user_id])
  @@index([rating_score(sort: Desc)])
  @@index([created_at(sort: Desc)])
}

model ForumVote {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  reply_id   String    @db.Uuid
  vote_type  String    @db.VarChar(20)
  created_at DateTime? @default(now()) @db.Timestamp(6)

  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  reply      ForumReply @relation(fields: [reply_id], references: [id], onDelete: Cascade)

  @@unique([user_id, reply_id])
  @@map("forum_votes")
}

model Tournament {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_by       String    @db.Uuid
  name             String    @db.VarChar(150)
  description      String?   @db.Text
  format           String?   @default("OU") @db.VarChar(50)
  status           String?   @default("open") @db.VarChar(50)
  max_participants Int?      @default(64)
  start_date       DateTime? @db.Timestamp(6)
  end_date         DateTime? @db.Timestamp(6)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)

  creator          User      @relation(fields: [created_by], references: [id], onDelete: Cascade)
  submissions      TournamentSubmission[]

  @@map("tournaments")
}

model TournamentSubmission {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tournament_id         String    @db.Uuid
  user_id               String    @db.Uuid
  team_id               String    @db.Uuid
  rating_at_submission  Decimal?  @db.Decimal(5, 2)
  wins                  Int?      @default(0)
  losses                Int?      @default(0)
  elo_rating            Decimal?  @default(1600) @db.Decimal(6, 2)
  submitted_at          DateTime? @default(now()) @db.Timestamp(6)

  tournament            Tournament @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  user                  User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  team                  Team       @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@unique([tournament_id, user_id, team_id])
  @@map("tournament_submissions")
}

model ForumReport {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporter_id String    @db.Uuid
  target_type String    @db.VarChar(50)
  target_id   String    @db.Uuid
  reason      String?   @db.VarChar(255)
  status      String?   @default("pending") @db.VarChar(20)
  created_at  DateTime? @default(now()) @db.Timestamp(6)

  reporter    User      @relation(fields: [reporter_id], references: [id], onDelete: Cascade)

  @@map("forum_reports")
}
